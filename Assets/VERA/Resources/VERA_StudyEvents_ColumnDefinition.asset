%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e490875681dccfc47bd4db3813ef95b7, type: 3}
  m_Name: VERA_StudyEvents_ColumnDefinition
  m_EditorClassIdentifier: VERA::VERA.VERAColumnDefinition
  fileType:
    fileTypeId: 6a55d8f40ce41dfc5f9190b8
    name: StudyEvents
    description: "One row per discrete event \u2014 the events_*.csv replacement."
    extension: csv
    skipUpload: 0
  skipAutoColumns: 0
  columns:
  - name: pID
    description: Unique identifier for each participant
    type: 1
  - name: conditions
    description: The active experimental conditions for each independent variable
      of your experiment (in JSON format)
    type: 3
  - name: ts
    description: Time since application start (in seconds)
    type: 6
  - name: timestamp_utc_ms
    description: see description above
    type: 6
  - name: platform
    description: "VR / Desktop / WebGL \u2014 not an IV, so not covered by conditions"
    type: 3
  - name: event_type
    description: "click, key_press, station_enter, station_exit, teleport, docent_guidance,
      quiz_response, session_start, session_end, \u2026"
    type: 3
  - name: target_id
    description: AttentionTarget / station / object id
    type: 3
  - name: detail
    description: free-text payload
    type: 3
  - name: world_x
    description: empty when not applicable
    type: 6
  - name: world_y
    description: empty when not applicable
    type: 6
  - name: world_z
    description: empty when not applicable
    type: 6
  - name: screen_x
    description: desktop/WebGL clicks only; empty in VR
    type: 6
  - name: screen_y
    description: desktop/WebGL clicks only; empty in VR
    type: 6
